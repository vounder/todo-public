# Run setup to create .env and generate TODO_ACCESS_KEY automatically.
# This template intentionally contains no access key and cannot start the server as-is.
COMPOSE_PROJECT_NAME=todo-public-local
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_HOST_PORT=8080
SERVER_CONTAINER_PORT=8080
MONGO_DB_NAME=todoapp
CORS_ORIGINS=
